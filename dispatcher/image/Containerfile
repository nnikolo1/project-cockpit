# The Workers' image (4m, 4e). Build with a context folder that holds this file and the Claude Code binary
# for Alpine arm64, named `claude` (copied here by hand; not committed). Nothing is fetched at run time.
#   container build -t cockpit-worker:latest -f dispatcher/image/Containerfile <context>
FROM docker.io/library/python:3.12-alpine

# git; libgcc/libstdc++/ripgrep are what the Alpine build of the CLI needs
RUN apk add --no-cache git libgcc libstdc++ ripgrep && pip install --no-cache-dir pytest
COPY claude /usr/local/bin/claude
RUN chmod 755 /usr/local/bin/claude
ENV USE_BUILTIN_RIPGREP=0

# workerN: unprivileged users, no sudo (4e, 4j). Keep the count equal to Config.image_workers in runtime.py.
# Each has its own CLAUDE_CONFIG_DIR with skipWebFetchPreflight (4i).
RUN for i in 1 2 3 4 5 6; do \
      adduser -D -u $((1000 + i)) worker$i && \
      mkdir -p /home/worker$i/.claude && \
      echo '{"skipWebFetchPreflight": true}' > /home/worker$i/.claude/settings.json && \
      chown -R worker$i /home/worker$i; \
    done
