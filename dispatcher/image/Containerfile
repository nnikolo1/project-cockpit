# The Workers' image (4m, 4e). Build with a context folder that holds the Claude Code binary for Alpine arm64,
# named `claude` (copied there by hand; not committed), and `dispatcher/relay.py` (copied to /opt/relay.py, 4f). Nothing is fetched at run time.
#   container build -t cockpit-worker:latest -f dispatcher/image/Containerfile <context>
FROM docker.io/library/python:3.12-alpine

# bash (the CLI needs a shell), git; libgcc/libstdc++/ripgrep are what the Alpine build of the CLI needs
RUN apk add --no-cache bash git libgcc libstdc++ ripgrep && pip install --no-cache-dir pytest
COPY claude /usr/local/bin/claude
COPY dispatcher/relay.py /opt/relay.py
COPY dispatcher/image/stop_hook.py dispatcher/note.py /opt/hook/
COPY dispatcher/image/skill/SKILL.md /opt/skill/goodbye-note/SKILL.md
RUN chmod 755 /usr/local/bin/claude
ENV USE_BUILTIN_RIPGREP=0

# workerN: unprivileged users, no sudo (4e, 4j). Keep the count equal to Config.image_workers in runtime.py.
# Each has its own CLAUDE_CONFIG_DIR with skipWebFetchPreflight (4i) and the permissions below.
# WORKER_SETTINGS is the one place to change the allowlist [proposed, not yet approved by the owner].
ARG WORKER_SETTINGS='{"skipWebFetchPreflight": true, "permissions": {"allow": ["Edit", "Write", "Bash(git:*)", "Bash(python3:*)", "Bash(pytest:*)", "Read", "Glob", "Grep", "WebSearch"], "deny": ["WebFetch"]}, "hooks": {"Stop": [{"hooks": [{"type": "command", "command": "python3 /opt/hook/stop_hook.py"}]}]}}'
RUN for i in 1 2 3 4 5 6; do \
      adduser -D -u $((1000 + i)) worker$i && \
      mkdir -p /home/worker$i/.claude && \
      printf '%s' "$WORKER_SETTINGS" > /home/worker$i/.claude/settings.json && \
      mkdir -p /home/worker$i/.claude/skills && cp -r /opt/skill/goodbye-note /home/worker$i/.claude/skills/ && \
      chown -R worker$i /home/worker$i; \
    done
