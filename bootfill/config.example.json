{
  "mode": "dry-run",
  "projects": [
    {"name": "widgets", "repo": "acme/widgets", "manager": "alice", "dir": "~/code/widgets",
     "modules": null, "board": null, "exclusions": "~/.local/share/project-cockpit/widgets/bootfill-exclusions.json"}
  ],
  "tracking_issue": {"project": "widgets", "number": 1},
  "quota_feed": "~/.local/share/project-cockpit/budget/quota.json",
  "budget_dir": "~/.local/share/project-cockpit/budget",
  "quota_history": "quota-history.jsonl",
  "quota_history_days": 400,
  "usage_report": null,
  "quota_refresh_cmd": ["claude", "-p", "ok", "--model", "haiku"],
  "transcript_glob": "~/.claude/projects/**/*.jsonl",
  "judge_cmd": ["claude", "-p", "{prompt}", "--model", "haiku"],
  "worker": {
    "command": ["claude", "-p", "{prompt}", "--allowedTools", "Read,Edit,Write,Glob,Grep,Bash(git status *),Bash(git diff *),Bash(git log *),Bash(git add *),Bash(git commit *),Bash(git switch *),Bash(git branch *),Bash(git push origin {branch_prefix}*),Bash(gh issue view *),Bash(gh pr view *),Bash(gh pr list *),Bash(gh issue comment *),Bash(gh pr comment *),Bash(gh issue edit * --add-assignee *),Bash(gh pr create *--draft*),Bash(python3 *),Bash(pytest *)"],
    "disallowed": [
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *:**)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(gh api *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr close *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue edit *--add-label*)",
      "Bash(gh issue edit *--remove-*)",
      "Bash(gh label *)",
      "Bash(gh repo *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(sqlite3 *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(ln *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python3 -m pip *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(brew *)",
      "Bash(git config *)",
      "WebFetch",
      "WebSearch"
    ],
    "branch_prefix": "boot/"
  },
  "worker_env": {"BOOTFILL_ROLE": "worker"},
  "worker_rules": null,
  "notify_cmd": ["osascript", "-e", "display notification \"{message}\" with title \"{title}\""],
  "poll_minutes": 10,
  "feed_stale_minutes": null,
  "idle_minutes": 10,
  "process_check": true,
  "process_names": ["claude"],
  "process_exclude": ["*.app/*", "*Chrome*", "*Claude Helper*", "*Claude.app*"],
  "transcript_exclude": ["*-wt-boot-*"],
  "headless_dir": null,
  "conflict_window": 6,
  "conflict_max_skips": 3,
  "conflict_labels": ["shared-files", "shared", "constitutional"],
  "conflict_judgement": true,
  "keep_awake": true,
  "keep_awake_minutes": null,
  "workers": 2,
  "day_cap": 60,
  "rerelease_guard_days": 30,
  "authority_mode": "skip",
  "authority_labels": ["needs-approval", "needs-owner", "needs-manager", "needs-pa", "owner-decision", "approval", "constitutional", "legal", "security", "policy"],
  "protected_paths": ["claude.md", "constitution.md", "*/schema.sql", "schema.sql", ".github/workflows/*", "docs/owner-defaults.md"],
  "authority_skip_score": 3,
  "authority_maybe_score": 1,
  "authority_judgement": true,
  "authority_judge_max": 10,
  "authority_excerpt_chars": 600,
  "authority_cache_hours": 24
}
