<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace the three UPPERCASE placeholders, copy to ~/Library/LaunchAgents/, then
     launchctl load ~/Library/LaunchAgents/com.project-cockpit.bootfill.plist
     Remove with launchctl unload. Runs one poll every 1800 s; the default mode is dry-run. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.project-cockpit.bootfill</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string><string>bootfill.job</string>
    <string>--config</string><string>CONFIG_PATH</string>
    <string>--data-dir</string><string>DATA_DIR</string>
    <string>--once</string>
  </array>
  <key>WorkingDirectory</key><string>COCKPIT_CHECKOUT</string>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
